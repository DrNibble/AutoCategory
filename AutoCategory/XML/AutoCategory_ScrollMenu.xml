<GuiXml>
    <Controls>
        <Control name="AC_ScrollMenuRow" virtual="true" mouseEnabled="true">
            <Dimensions y="28"/>
            <Controls>
                <Backdrop name="$(parent)Highlight" inherits="ZO_SelectionHighlight" hidden="true">
                    <AnchorFill/>
                </Backdrop>
                <Label name="$(parent)Label" font="ZoFontGame" wrapMode="ELLIPSIS" maxLineCount="1"/>
                <Label name="$(parent)Arrow" font="ZoFontGame" text="&gt;" hidden="true">
                    <Anchor point="RIGHT" offsetX="-8"/>
                </Label>
                <Texture name="$(parent)Divider" hidden="true">
                    <Dimensions y="1"/>
                    <Anchor point="LEFT" offsetX="8"/>
                    <Anchor point="RIGHT" offsetX="-8"/>
                    <Color r="0.65" g="0.58" b="0.4" a="0.8"/>
                </Texture>
                <Button name="$(parent)Check" inherits="ZO_CheckButton" hidden="true">
                    <Anchor point="LEFT" offsetX="5"/>
                </Button>
                <Slider name="$(parent)Slider" orientation="HORIZONTAL" mouseEnabled="true" hidden="true">
                    <Dimensions x="120" y="16"/>
                    <Anchor point="RIGHT" offsetX="-47"/>
                    <ThumbTexture textureFile="EsoUI/Art/Miscellaneous/scrollbox_elevator.dds"
                        thumbWidth="8" thumbHeight="16"/>
                    <Controls>
                        <Backdrop name="$(parent)Backdrop" inherits="ZO_SliderBackdrop"/>
                    </Controls>
                </Slider>
                <Label name="$(parent)Value" font="ZoFontGame" hidden="true">
                    <Anchor point="RIGHT" offsetX="-4"/>
                </Label>
            </Controls>
        </Control>

        <TopLevelControl name="AC_ScrollMenuPanel" virtual="true" hidden="true"
            mouseEnabled="true" tier="HIGH" clampedToScreen="true">
            <Controls>
                <Backdrop name="$(parent)Background" inherits="ZO_DefaultBackdrop">
                    <AnchorFill/>
                </Backdrop>
                <Backdrop name="$(parent)Search" inherits="ZO_SingleLineEditBackdrop_Keyboard" hidden="true">
                    <Anchor point="TOPLEFT" offsetX="8" offsetY="7"/>
                    <Anchor point="TOPRIGHT" offsetX="-8" offsetY="7"/>
                    <Controls>
                        <EditBox name="$(parent)Edit" inherits="ZO_DefaultEditForBackdrop"/>
                    </Controls>
                </Backdrop>
                <Control name="$(parent)List" inherits="ZO_ScrollList"/>
            </Controls>
        </TopLevelControl>
        <TopLevelControl name="AC_ScrollMenuRoot" inherits="AC_ScrollMenuPanel" level="20"/>
        <TopLevelControl name="AC_ScrollMenuSide" inherits="AC_ScrollMenuPanel" level="21"/>
    </Controls>
</GuiXml>
