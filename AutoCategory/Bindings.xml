<Bindings>
	<Layer name="SI_KEYBINDINGS_LAYER_GENERAL">
		<Category name="Auto Category">
			<Action name="TOGGLE_AUTO_CATEGORY">
				<Down>AC_Binding_ToggleCategorize()</Down>  
			</Action>
		</Category>
	</Layer>
	<Layer name="AutoCategoryCategoryManagement">
		<Category>
			<Action name="AC_CATEGORY_MANAGEMENT_CANCEL_ESCAPE" hideAction="true" rebindable="false" inheritsBindFrom="TOGGLE_SYSTEM">
				<Down>return AutoCategory.CategoryManagement.Cancel()</Down>
			</Action>
			<Action name="AC_CATEGORY_MANAGEMENT_CANCEL_ALT" hideAction="true" rebindable="false" inheritsBindFrom="TOGGLE_GAME_CAMERA_UI_MODE">
				<Down>return AutoCategory.CategoryManagement.Cancel()</Down>
			</Action>
		</Category>
	</Layer>
</Bindings>
